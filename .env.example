# Copy to .env.local and fill in. Never commit real values.

# ---- Public (sent to the browser) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Never put a secret/service_role key here —
# the app refuses to start if you do.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Server only (never prefix with NEXT_PUBLIC_) ----
# Secret key (sb_secret_...) or legacy service_role key. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# AI concierge: an OpenAI-compatible gateway (POST {LLM_BASE_URL}/chat/completions).
# Base URL including the version path, e.g. https://<gateway>/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=agnes-2.5-flash
# Payment gateway (not used yet: Phase 7 ships manual bank transfer)
PAYMENT_SECRET=
WEBHOOK_SECRET=
ADMIN_SECRET=
# Vercel Cron bearer secret for /api/cron/* (e.g. expiring unpaid orders)
CRON_SECRET=
